# Backend (FastAPI). No servidor use BACKEND_URL (rede interna do compose);
# no navegador use NEXT_PUBLIC_API_URL (URL pública).
# Desenvolvimento local: ambos http://localhost:8000.
BACKEND_URL=
NEXT_PUBLIC_API_URL=
# Limite de upload em MB (compose: deve ser <= client_max_body_size do nginx).
MAX_UPLOAD_MB=20
