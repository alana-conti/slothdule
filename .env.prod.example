# Produção (VPS) — nunca commite este arquivo com valores reais.
POSTGRES_USER=slothdule
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=slothdule
JWT_SECRET=troque-por-segredo-longo-aleatorio
SITE_HOST=app.seu-dominio
API_HOST=api.seu-dominio
CORS_ORIGINS=https://app.seu-dominio
# Destino dos redirects pós-oAuth (callback do Google). Sem ele o login
# Google cai no default https://seu-dominio.
FRONTEND_URL=https://app.seu-dominio
# Login com Google (opcional; sem elas o botão mostra erro amigável).
# Redirect URI no Google Cloud: https://api.seu-dominio/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Usada só no primeiro `docker compose up -d` (build local do front).
# Nos deploys via CI a imagem já vem pronta do GHCR; o valor precisa ser
# o mesmo do secret PUBLIC_API_URL do GitHub.
PUBLIC_API_URL=https://api.seu-dominio
# Limite de upload da API (deve ser <= client_max_body_size do nginx).
MAX_UPLOAD_MB=20
