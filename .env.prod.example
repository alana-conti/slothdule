# Produção (VPS) — nunca commite este arquivo com valores reais.
# Os domínios abaixo já são os defaults do compose; presentes aqui para
# referência (e para sobrescrever quando precisar, ex.: domínio de staging).
POSTGRES_USER=slothdule
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=slothdule
JWT_SECRET=troque-por-segredo-longo-aleatorio
SITE_HOST=app.slothdule.guivi.tech
API_HOST=api.slothdule.guivi.tech
CORS_ORIGINS=https://app.slothdule.guivi.tech
# Destino dos redirects pós-oAuth (callback do Google).
FRONTEND_URL=https://app.slothdule.guivi.tech
# Domínio pai dos cookies de sessão. Obrigatório quando app e api são
# subdomínios diferentes.
COOKIE_DOMAIN=.slothdule.guivi.tech
# Login com Google (opcional; sem elas o botão mostra erro amigável).
# Redirect URI no Google Cloud: https://api.slothdule.guivi.tech/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Usada só no primeiro `docker compose up -d` (build local do front).
# Nos deploys via CI a imagem já vem pronta do GHCR; o valor precisa ser
# o mesmo do secret PUBLIC_API_URL do GitHub.
PUBLIC_API_URL=https://api.slothdule.guivi.tech
# Limite de upload da API (deve ser <= client_max_body_size do nginx).
MAX_UPLOAD_MB=20
