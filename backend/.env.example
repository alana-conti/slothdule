# Copie para backend/.env e ajuste. Nunca commite o .env real.
DATABASE_URL=postgresql+psycopg://slothdule:slothdule@localhost:5432/slothdule
JWT_SECRET=troque-este-segredo-em-producao
ACCESS_TTL_SECONDS=3600
REFRESH_TTL_DAYS=30
DATA_DIR=/data
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Fase 7 (OAuth Google): credenciais do Google Cloud (OAuth client "Web").
# Redirect URI lá: <API pública>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: force a URL pública da API se estiver atrás de proxy/reverso.
GOOGLE_REDIRECT_URI=
# URL pública do frontend (destino dos redirects do OAuth).
FRONTEND_URL=http://localhost:3000
