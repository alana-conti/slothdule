# Frontend (serviço `web` no compose) + API (serviço `api`) na mesma VPS.
# Se preferir manter o Next na Vercel, remova o bloco SITE_HOST e ajuste
# CORS_ORIGINS/NEXT_PUBLIC_API_URL para o domínio da Vercel.

{$API_HOST} {
	reverse_proxy api:8000
}

# Descomente para servir o frontend na VPS (serviço `web` no compose):
{$SITE_HOST} {
	reverse_proxy web:3000
}
